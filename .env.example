# Copy to .env and fill in the two required keys. Both have free tiers that need no credit card.

# Required. Free key from https://console.groq.com/keys
LLM_API_KEY=

# Required. Free key from https://dashboard.exa.ai/api-keys ($10 of searches free each month)
EXA_API_KEY=

# Optional. Any OpenAI-compatible host works (NVIDIA https://integrate.api.nvidia.com/v1,
# OpenRouter https://openrouter.ai/api/v1, local Ollama http://localhost:11434/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Used when the main model hits its free-tier rate limit. Leave empty to disable.
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional: a durable copy of the history in Turso (free at https://app.turso.tech), for hosts that
# wipe the disk on restart. Without these, history lives only in DB_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional
PORT=3000
DB_PATH=data/chat.db
